POSTGRES_DB=taskminer
POSTGRES_USER=taskminer
POSTGRES_PASSWORD=taskminer123
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://taskminer:taskminer123@postgres:5432/taskminer
TASKMINER_LOG_LEVEL=INFO
TASKMINER_AI_PROVIDER=mock
TASKMINER_OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=replace-with-a-server-side-key-when-provider-is-openai
# Optional emergency ceiling; normal monthly quotas come from the workspace plan.
# TASKMINER_AI_MONTHLY_REQUEST_LIMIT=100
TASKMINER_AI_RATE_LIMIT_REQUESTS=10
TASKMINER_AI_RATE_LIMIT_WINDOW_SECONDS=60
TASKMINER_AUTH_LOGIN_RATE_LIMIT_REQUESTS=10
TASKMINER_AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
TASKMINER_AUTH_REGISTER_RATE_LIMIT_REQUESTS=5
TASKMINER_AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
TASKMINER_AUTH_PASSWORD_RESET_RATE_LIMIT_REQUESTS=5
TASKMINER_AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
TASKMINER_AUTH_EMAIL_VERIFICATION_RATE_LIMIT_REQUESTS=5
TASKMINER_AUTH_EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600
TASKMINER_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
TASKMINER_PASSWORD_RESET_COOLDOWN_SECONDS=60
TASKMINER_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
TASKMINER_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Number of trusted reverse proxies between the public client and FastAPI.
TASKMINER_TRUSTED_PROXY_HOPS=0
TASKMINER_EMAIL_PROVIDER=noop
TASKMINER_EMAIL_FROM=TaskMiner <invitations@taskminer.app>
TASKMINER_FRONTEND_URL=http://localhost:3000
# RESEND_API_KEY=replace-with-a-server-side-key-when-provider-is-resend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
TASKMINER_BILLING_SUCCESS_URL=http://localhost:3000/app/workspaces?billing=success
TASKMINER_BILLING_CANCEL_URL=http://localhost:3000/app/workspaces?billing=cancelled
STORAGE_PATH=/app/storage
TASKMINER_ATTACHMENT_WORKSPACE_QUOTA_BYTES=1073741824
TASKMINER_ATTACHMENT_UPLOAD_RATE_LIMIT_REQUESTS=20
TASKMINER_ATTACHMENT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://taskminer.app,https://www.taskminer.app
# CORS_ORIGIN_REGEX=^https://task-miner(?:-[a-z0-9-]+)*\.vercel\.app$

BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
