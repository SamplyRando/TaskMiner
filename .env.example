POSTGRES_DB=taskminer
POSTGRES_USER=taskminer
POSTGRES_PASSWORD=taskminer123
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://taskminer:taskminer123@postgres:5432/taskminer
TASKMINER_LOG_LEVEL=INFO
TASKMINER_AI_PROVIDER=mock
TASKMINER_OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=replace-with-a-server-side-key-when-provider-is-openai
# Optional emergency ceiling; normal monthly quotas come from the workspace plan.
# TASKMINER_AI_MONTHLY_REQUEST_LIMIT=100
TASKMINER_AI_RATE_LIMIT_REQUESTS=10
TASKMINER_AI_RATE_LIMIT_WINDOW_SECONDS=60
TASKMINER_EMAIL_PROVIDER=noop
TASKMINER_EMAIL_FROM=TaskMiner <invitations@taskminer.app>
TASKMINER_FRONTEND_URL=http://localhost:3000
# RESEND_API_KEY=replace-with-a-server-side-key-when-provider-is-resend
STORAGE_PATH=/app/storage
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://taskminer.app,https://www.taskminer.app
# CORS_ORIGIN_REGEX=^https://task-miner(?:-[a-z0-9-]+)*\.vercel\.app$

BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
